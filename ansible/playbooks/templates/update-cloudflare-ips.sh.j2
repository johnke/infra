#!/bin/sh
# Managed by Ansible - DO NOT EDIT MANUALLY
#
# Refresh Cloudflare's published edge ranges and apply them to:
#   1. the pf <cloudflare> table (origin protection for {{ cloudflare_web_ports | join('/') }})
#   2. nginx's set_real_ip_from list (so logs show the visitor, not the edge)
#
# Unlike the ufw equivalent this does not rebuild rules: pf tables are
# replaced atomically with `pfctl -T replace`, so there is no window where
# the ruleset is permissive or empty.

set -eu

IP_FILE="{{ cloudflare_ip_file }}"
SNIPPET="{{ nginx_cloudflare_snippet }}"
TMP_IP="$(mktemp)"
TMP_SNIP="$(mktemp)"
trap 'rm -f "$TMP_IP" "$TMP_SNIP"' EXIT

fetch() {
    # -S surfaces errors, and ftp(1) is in base -- no curl dependency.
    ftp -o - "$1" 2>/dev/null
}

V4="$(fetch https://www.cloudflare.com/ips-v4)" || V4=""
V6="$(fetch https://www.cloudflare.com/ips-v6)" || V6=""

if [ -z "$V4" ] || [ -z "$V6" ]; then
    logger -t update-cloudflare-ips -p daemon.err \
        "failed to fetch Cloudflare ranges; keeping existing $IP_FILE"
    exit 1
fi

# Sanity check before touching anything: a truncated or error-page response
# must never be allowed to shrink the table to nothing.
printf '%s\n%s\n' "$V4" "$V6" | grep -E '^[0-9a-fA-F:.]+/[0-9]+$' > "$TMP_IP" || true
COUNT="$(wc -l < "$TMP_IP" | tr -d ' ')"
if [ "$COUNT" -lt 10 ]; then
    logger -t update-cloudflare-ips -p daemon.err \
        "only $COUNT valid ranges parsed (expected 20+); refusing to apply"
    exit 1
fi

# --- pf table ---
if ! cmp -s "$TMP_IP" "$IP_FILE" 2>/dev/null; then
    cat "$TMP_IP" > "$IP_FILE"
    chmod 0644 "$IP_FILE"
    # Replace the live table without reloading the whole ruleset, so active
    # states and the <bruteforce> table are preserved.
    if pfctl -T replace -t cloudflare -f "$IP_FILE"; then
        logger -t update-cloudflare-ips -p daemon.info \
            "pf <cloudflare> table updated ($COUNT ranges)"
    else
        logger -t update-cloudflare-ips -p daemon.err \
            "pfctl -T replace failed"
        exit 1
    fi
fi

# --- nginx real_ip snippet ---
{
    echo "# Auto-generated by update-cloudflare-ips - do not edit manually"
    echo "# Trust Cloudflare's edge and take the client IP from CF-Connecting-IP,"
    echo "# otherwise every request would be logged as coming from Cloudflare."
    echo "real_ip_header CF-Connecting-IP;"
    echo
    while read -r ip; do
        [ -n "$ip" ] && echo "set_real_ip_from $ip;"
    done < "$TMP_IP"
} > "$TMP_SNIP"

if ! cmp -s "$TMP_SNIP" "$SNIPPET" 2>/dev/null; then
    cat "$TMP_SNIP" > "$SNIPPET"
    chmod 0644 "$SNIPPET"
    # Only reload a running nginx, and never fail the whole run because of an
    # unrelated config error elsewhere: the snippet itself is already written,
    # which is what the playbook needs before it deploys nginx.conf.
    if ! rcctl check nginx >/dev/null 2>&1; then
        logger -t update-cloudflare-ips -p daemon.info \
            "snippet written; nginx not running, nothing to reload"
    elif nginx -t >/dev/null 2>&1; then
        rcctl reload nginx
        logger -t update-cloudflare-ips -p daemon.info \
            "nginx real_ip snippet updated and reloaded"
    else
        logger -t update-cloudflare-ips -p daemon.err \
            "snippet written but nginx -t fails; NOT reloading (check nginx.conf)"
    fi
fi
