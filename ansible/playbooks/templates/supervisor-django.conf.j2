# Managed by Ansible - DO NOT EDIT MANUALLY
[program:{{ item.name }}]
command={{ item.root }}/venv/bin/gunicorn {{ item.wsgi_module | default('config.wsgi:application') }} -c {{ item.root }}/gunicorn_config.py
directory={{ item.root }}
user={{ item.user | default('www-data') }}
autostart=true
autorestart=true
redirect_stderr=true
stdout_logfile={{ item.root }}/logs/supervisor.log
environment=PATH="{{ item.root }}/venv/bin"
{% if item.supervisor_environment is defined %}
{% for key, value in item.supervisor_environment.items() %}
    ,{{ key }}="{{ value }}"
{% endfor %}
{% endif %}
