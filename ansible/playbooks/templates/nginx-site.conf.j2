# Managed by Ansible - DO NOT EDIT MANUALLY
# Static site
{#- nginx on OpenBSD is chrooted to /var/www, so strip that prefix from
    paths used inside the config. -#}
{% set chroot_root = item.root | regex_replace('^' ~ chroot_base, '') %}
{#- Serve HTTPS only once the certificate exists: nginx refuses to start if
    a configured certificate file is missing, which would otherwise wedge the
    whole server until the certificate is installed. -#}
{% set has_cert = item.name in (sites_with_certs | default([item.name])) %}
{% if item.ssl_enabled and has_cert %}

# HTTPS server block
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {{ item.server_names | join(' ') }};

    # SSL configuration (shared settings live in nginx.conf)
    ssl_certificate {{ item.ssl_certificate }};
    ssl_certificate_key {{ item.ssl_certificate_key }};

    add_header Strict-Transport-Security "max-age=63072000" always;

    # Logging (real paths: nginx opens logs before chrooting)
    access_log {{ nginx_log_dir }}/{{ item.name }}-access.log main;
    error_log {{ nginx_log_dir }}/{{ item.name }}-error.log;

    # Document root
    root {{ chroot_root }};
    index index.html index.htm;

    location / {
        try_files $uri $uri/ =404;
    }

{% if item.custom_config is defined %}
    # Custom configuration
{{ item.custom_config | trim | indent(4, first=True) }}
{% endif %}
}

# HTTP to HTTPS redirect
server {
    listen 80;
    listen [::]:80;
    server_name {{ item.server_names | join(' ') }};

    return 301 https://$host$request_uri;
}
{% else %}
# HTTP only server block
server {
    listen 80;
    listen [::]:80;
    server_name {{ item.server_names | join(' ') }};

    # Logging (real paths: nginx opens logs before chrooting)
    access_log {{ nginx_log_dir }}/{{ item.name }}-access.log main;
    error_log {{ nginx_log_dir }}/{{ item.name }}-error.log;


    # Document root
    root {{ chroot_root }};
    index index.html index.htm;

    location / {
        try_files $uri $uri/ =404;
    }

{% if item.custom_config is defined %}
    # Custom configuration
{{ item.custom_config | trim | indent(4, first=True) }}
{% endif %}
}
{% endif %}
