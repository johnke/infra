# Managed by Ansible - DO NOT EDIT MANUALLY
# Main nginx configuration for OpenBSD (nginx runs chrooted in /var/www)

user {{ web_user }} {{ web_group }};
worker_processes auto;

events {
    worker_connections 1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';

    access_log  {{ nginx_log_dir }}/access.log main;
    error_log   {{ nginx_log_dir }}/error.log;

    sendfile        on;
    tcp_nopush      on;
    tcp_nodelay     on;
    keepalive_timeout  65;
    server_tokens   off;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_types text/plain text/css application/json application/javascript
               text/xml application/xml application/xml+rss text/javascript
               image/svg+xml;

{% if cloudflare_only_web | default(false) %}
    # Cloudflare edge ranges + real_ip_header, generated by
    # update-cloudflare-ips(8) and refreshed by cron. Without this, every
    # request would be logged with Cloudflare's address instead of the
    # visitor's. Created by the playbook before nginx first starts.
    include {{ nginx_cloudflare_snippet }};

{% endif %}
    # WebSocket upgrade support for reverse-proxied sites. Sending a bare
    # "upgrade" Connection header on every request breaks keepalive for
    # ordinary requests, so derive it from $http_upgrade instead.
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # Shared TLS settings
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_dhparam /etc/ssl/dhparam.pem;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:50m;
    ssl_session_tickets off;
    # OCSP stapling is deliberately OFF: the Cloudflare Origin certificate has
    # no publicly resolvable issuer chain, so stapling can never succeed and
    # nginx warns "issuer certificate not found" on every start and -t run.
    # Re-enable per-site if a publicly-issued certificate is ever used here.
    ssl_stapling off;

    # Default server: reject requests for unknown hostnames
    server {
        listen 80 default_server;
        listen [::]:80 default_server;
        server_name _;
        return 444;
    }

    include conf.d/*.conf;
}
